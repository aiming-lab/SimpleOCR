# Environment variables for SimpleOCR
# Copy this file to .env and fill in your actual values

# Azure OpenAI API (for evaluation with GPT-4)
# Get these from your Azure OpenAI resource in Azure Portal
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-2024-08-06
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Hugging Face (for downloading models and datasets)
HF_TOKEN=your-huggingface-token
HF_ENDPOINT=https://huggingface.co  # or https://hf-mirror.com for China

# Weights & Biases (for experiment tracking)
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=simpleocr

# CUDA settings
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
